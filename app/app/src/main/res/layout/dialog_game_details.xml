<?xml version="1.0" encoding="utf-8"?>

<!-- Fields of the "Game details" popup. The players are edited through the pills instead. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <!-- Game name, also written as [Event] in the PGN -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/details_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/detailsName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="@color/text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Where the game was played -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/details_site">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/detailsSite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textColor="@color/text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date of the game; tapping it opens a date picker instead of the keyboard -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/details_date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/detailsDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:textColor="@color/text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Round of a tournament, e.g. 9 -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/details_round">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/detailsRound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Result: exactly one of the four is selected -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/details_result"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/detailsResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/resultWhiteWins"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAllCaps="false"
                app:backgroundTint="@color/result_button_background"
                android:text="@string/result_white_wins"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/resultDraw"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAllCaps="false"
                app:backgroundTint="@color/result_button_background"
                android:text="@string/result_draw"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/resultBlackWins"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAllCaps="false"
                app:backgroundTint="@color/result_button_background"
                android:text="@string/result_black_wins"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/resultUnknown"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAllCaps="false"
                app:backgroundTint="@color/result_button_background"
                android:text="@string/result_unknown"
                android:textColor="@color/text" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

</ScrollView>
