<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Game name and import date -->

    <TextView
        android:id="@+id/gameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:text="@string/placeholder"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gameImportDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <!-- Chess Board-->

    <com.example.chess_clock_app.views.ChessBoardView
        android:id="@+id/chessBoard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <!-- Moves with their clock times -->

    <ScrollView
        android:id="@+id/movesScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/movesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text"
            android:textSize="16sp" />

    </ScrollView>

    <!-- Previous move / save / next move buttons-->

    <LinearLayout
        android:id="@+id/moveButtonsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previousMoveButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/list_item_background"
            android:contentDescription="@string/previous_move"
            app:icon="@drawable/arrow_left"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveMovesButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/list_item_background"
            android:text="@string/save"
            android:textColor="@color/text" />

        <!-- Same arrow as the left button, mirrored -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextMoveButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/list_item_background"
            android:contentDescription="@string/next_move"
            android:scaleX="-1"
            app:icon="@drawable/arrow_left"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/text" />

    </LinearLayout>

</LinearLayout>
